#!/usr/bin/env bash

# automatically called inside nix dev env
# serves as background daemon to respond to calls for wpilib applications
# DONT directly call, especially outside of the nix env
# this isn't exactly needed, and technically overly complex

LC_ALL="en_US.UTF-8"

errout(){
	local errtxt errcode
	case $# in
		0)
			errtxt="reason not provided"
			errcode=1
			;;
		1)
			errtxt="$1"
			errcode=1;
			;;
		*)
			errtxt="$1"
			errcode="$2"
			;;
	esac
		
	echo "exiting: $errtxt"
	
	exit $errcode
}

if ! [[ "$PS1" =~ ^\(nix\) ]]; then
	errout "called outside of the correct nix develop env" 1
fi




